#!/bin/sh

set -eu

method="GET"
url=""
data=""
authorization=""
scope=""
dump_header=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --request)
      method="$2"
      shift
      ;;
    --data|--data-urlencode)
      data="$2"
      case "$2" in
        scope=*) scope="${2#scope=}" ;;
      esac
      shift
      ;;
    --header)
      case "$2" in
        "Authorization: Bearer "*) authorization="${2#Authorization: Bearer }" ;;
      esac
      shift
      ;;
    --connect-timeout|--max-time)
      shift
      ;;
    --dump-header)
      dump_header="$2"
      shift
      ;;
    --fail|--silent|--show-error)
      ;;
    *)
      url="$1"
      ;;
  esac
  shift
done

trace() {
  if [ -n "${FAKE_PHASE3_TRACE:-}" ]; then
    printf '%s\n' "$1" >> "$FAKE_PHASE3_TRACE"
  fi
}

write_correlation_header() {
  if [ -n "$dump_header" ]; then
    printf 'HTTP/1.1 200 OK\r\nX-Correlation-ID: 27111111-1111-1111-1111-111111111111\r\n\r\n' \
      > "$dump_header"
  fi
}

case "$url" in
  */health/ready)
    trace "GET readiness"
    if [ "${MESSAGING_ADAPTER:-Kafka}" = Dapr ] \
      && [ "${FAKE_PHASE3_NO_DAPR:-false}" != true ]; then
      printf '%s' '{"status":"Healthy","checks":[{"name":"dapr","status":"Healthy","durationMilliseconds":1},{"name":"postgresql","status":"Healthy","durationMilliseconds":1},{"name":"redis","status":"Healthy","durationMilliseconds":1}]}'
    elif [ "${FAKE_PHASE3_NO_KAFKA:-false}" = true ] \
      || [ "${FAKE_PHASE3_NO_DAPR:-false}" = true ]; then
      printf '%s' '{"status":"Healthy","checks":[{"name":"postgresql","status":"Healthy","durationMilliseconds":1},{"name":"redis","status":"Healthy","durationMilliseconds":1}]}'
    elif [ "${AUTHENTICATION_ENABLED:-false}" = true ]; then
      printf '%s' '{"status":"Healthy","checks":[{"name":"identity-provider","status":"Healthy","durationMilliseconds":1},{"name":"kafka","status":"Healthy","durationMilliseconds":1},{"name":"postgresql","status":"Healthy","durationMilliseconds":1},{"name":"redis","status":"Healthy","durationMilliseconds":1},{"name":"schema-registry","status":"Healthy","durationMilliseconds":1}]}'
    else
      printf '%s' '{"status":"Healthy","checks":[{"name":"kafka","status":"Healthy","durationMilliseconds":1},{"name":"postgresql","status":"Healthy","durationMilliseconds":1},{"name":"redis","status":"Healthy","durationMilliseconds":1},{"name":"schema-registry","status":"Healthy","durationMilliseconds":1}]}'
    fi
    ;;
  */v1.0/metadata)
    trace "GET dapr metadata"
    printf '%s' '{"id":"coffeeshop-api","components":[{"name":"coffeeshop-pubsub","type":"pubsub.kafka"}],"subscriptions":[{"topic":"coffeeshop.orders.v1"},{"topic":"coffeeshop.preparation.v1"}]}'
    ;;
  */protocol/openid-connect/token)
    if [ "$scope" != openid ]; then
      exit 22
    fi
    trace "POST token"
    printf '%s' '{"access_token":"controlled-phase3-token"}'
    ;;
  */protocol/openid-connect/userinfo)
    if [ "$authorization" != controlled-phase3-token ]; then
      exit 22
    fi
    trace "GET userinfo authenticated"
    printf '%s' '{"sub":"11111111-2222-3333-4444-555555555555"}'
    ;;
  */v1/api/orders)
    trace "POST order-v1"
    loyalty="$(printf '%s' "$data" | sed -n 's/.*"loyaltyMemberId":"\([^"]*\)".*/\1/p')"
    printf '%s' "$loyalty" > "${FAKE_PHASE3_STATE:?}"
    write_correlation_header
    printf '%s' '{}'
    ;;
  */v1/api/fulfillment-orders)
    trace "GET fulfilled-v1"
    if [ "${FAKE_PHASE3_NEVER_FULFILLED:-false}" = true ]; then
      printf '%s' '[]'
    else
      loyalty="$(cat "${FAKE_PHASE3_STATE:?}")"
      printf '[{"loyaltyMemberId":"%s","status":"Fulfilled"}]' "$loyalty"
    fi
    ;;
  */v2/orders)
    if [ "$method" != POST ] || [ "$authorization" != controlled-phase3-token ]; then
      exit 22
    fi
    loyalty="$(printf '%s' "$data" | sed -n 's/.*"loyaltyMemberId":"\([^"]*\)".*/\1/p')"
    if [ "$loyalty" != 11111111-2222-3333-4444-555555555555 ]; then
      exit 22
    fi
    printf '%s' "$loyalty" > "${FAKE_PHASE3_STATE:?}"
    write_correlation_header
    trace "POST order-v2 authenticated"
    printf '%s' '{"orderId":"7a97d7bf-f7e3-4294-9d5c-b95b957342c5","status":"InProgress"}'
    ;;
  */v2/orders/*)
    if [ "$authorization" != controlled-phase3-token ]; then
      exit 22
    fi
    trace "GET order-v2 authenticated"
    if [ "${FAKE_PHASE3_NEVER_FULFILLED:-false}" = true ]; then
      printf '%s' '{"orderId":"7a97d7bf-f7e3-4294-9d5c-b95b957342c5","status":"InProgress"}'
    else
      printf '%s' '{"orderId":"7a97d7bf-f7e3-4294-9d5c-b95b957342c5","status":"Fulfilled"}'
    fi
    ;;
  */subjects)
    trace "GET schema subjects"
    if [ "${FAKE_PHASE3_NO_SCHEMAS:-false}" = true ]; then
      printf '%s' '["CoffeeShop.Events.V1.OrderPlacedV1"]'
    else
      printf '%s' '["CoffeeShop.Events.V1.OrderPlacedV1","CoffeeShop.Events.V1.OrderItemPreparedV1"]'
    fi
    ;;
  */metrics)
    trace "GET telemetry metrics"
    if [ "${FAKE_PHASE3_NO_TELEMETRY:-false}" = true ]; then
      printf '%s' '# telemetry unavailable'
    else
      printf '%s\n' \
        'coffeeshop_messaging_publish_count_total{event_type="coffeeshop.order-placed"} 1' \
        'coffeeshop_messaging_consume_count_total{event_type="coffeeshop.order-placed"} 2' \
        'coffeeshop_messaging_outbox_publish_attempts_total{module="counter"} 1' \
        'coffeeshop_messaging_deadletter_forwarded_total{event_type="unknown"} 2'
    fi
    ;;
  */api/services)
    trace "GET jaeger services"
    if [ "${FAKE_PHASE3_NO_TELEMETRY:-false}" = true ]; then
      printf '%s' '{"data":[]}'
    else
      printf '%s' '{"data":["coffeeshop-api"]}'
    fi
    ;;
  */api/traces*)
    trace "GET jaeger traces"
    if [ "${FAKE_PHASE3_NO_TELEMETRY:-false}" = true ]; then
      printf '%s' '{"data":[]}'
    else
      printf '%s' '{"data":[{"spans":[{"operationName":"coffeeshop.order-placed publish"},{"operationName":"coffeeshop.order-placed process"}]}]}'
    fi
    ;;
  *)
    echo "Unexpected phase 3 fake curl URL: $url" >&2
    exit 2
    ;;
esac
