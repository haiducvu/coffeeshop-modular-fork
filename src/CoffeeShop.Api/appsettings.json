{
  "ClientOrigin": "http://localhost:5173",
  "Messaging": {
    "Kafka": {
      "Enabled": true,
      "BootstrapServers": "localhost:9092",
      "TopicPrefix": "coffeeshop",
      "ConsumerGroupPrefix": "coffeeshop"
    },
    "CounterOutbox": {
      "BatchSize": 20,
      "PollInterval": "00:00:01",
      "LeaseDuration": "00:00:30",
      "RetryDelay": "00:00:05"
    },
    "BaristaOutbox": {
      "BatchSize": 20,
      "PollInterval": "00:00:01",
      "LeaseDuration": "00:00:30",
      "RetryDelay": "00:00:05"
    },
    "KitchenOutbox": {
      "BatchSize": 20,
      "PollInterval": "00:00:01",
      "LeaseDuration": "00:00:30",
      "RetryDelay": "00:00:05"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "CoffeeShop.Api.Logging.SensitiveDataDestructuringPolicy, CoffeeShop.Api"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
