{
  "ClientOrigin": "http://localhost:5173",
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Modules": {
    "Barista": {
      "Hosting": "Embedded"
    },
    "Kitchen": {
      "Hosting": "Embedded"
    }
  },
  "Messaging": {
    "Adapter": "Kafka",
    "Dapr": {
      "PubSubName": "coffeeshop-pubsub",
      "TopicPrefix": "coffeeshop",
      "AppApiToken": "",
      "SidecarHttpEndpoint": "http://127.0.0.1:3500",
      "SidecarGrpcEndpoint": "http://127.0.0.1:50001"
    },
    "Kafka": {
      "Enabled": true,
      "BootstrapServers": "localhost:9092",
      "SchemaRegistryUrl": "http://localhost:8081",
      "ProducerFormat": "Avro",
      "TopicPrefix": "coffeeshop",
      "ConsumerGroupPrefix": "coffeeshop",
      "Retry": {
        "FirstDelay": "00:00:01",
        "SecondDelay": "00:00:05",
        "MaxPollInterval": "00:05:00"
      }
    },
    "CounterOutbox": {
      "BatchSize": 20,
      "PollInterval": "00:00:01",
      "LeaseDuration": "00:00:30",
      "RetryDelay": "00:00:05"
    },
    "BaristaOutbox": {
      "BatchSize": 20,
      "PollInterval": "00:00:01",
      "LeaseDuration": "00:00:30",
      "RetryDelay": "00:00:05"
    },
    "KitchenOutbox": {
      "BatchSize": 20,
      "PollInterval": "00:00:01",
      "LeaseDuration": "00:00:30",
      "RetryDelay": "00:00:05"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "CoffeeShop.Api.Logging.SensitiveDataDestructuringPolicy, CoffeeShop.Api"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
